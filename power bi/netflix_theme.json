{
  "name": "Netflix Dark",
  "dataColors": ["#E50914", "#8B0A12", "#B3B3B3", "#FFFFFF", "#5C0A10", "#FF5A5F"],
  "background": "#141414",
  "foreground": "#FFFFFF",
  "tableAccent": "#E50914",
  "visualStyles": {
    "*": {
      "*": {
